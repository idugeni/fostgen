# ---------------------------------------------------------------------------
# Copy to `.env.local` and fill in what you need. Every value is optional.
# ---------------------------------------------------------------------------

# A GitHub personal access token (classic or fine-grained).
# Raises the API rate limit from 60 to 5,000 requests/hour and allows reading
# private repositories the token can access. It is only ever read on the server
# and never sent to the browser. No scopes are required for public repos.
GITHUB_TOKEN=

# Absolute public origin, used for canonical URLs, robots.txt and sitemap.xml.
# On Vercel this is derived automatically from VERCEL_PROJECT_PRODUCTION_URL.
NEXT_PUBLIC_SITE_URL=

# debug | info | warn | error | silent
# Defaults to `debug` in development and `info` in production.
LOG_LEVEL=
